Cell[CellGroupData[{
Cell["Wigner-d Matrices", "Subsubsection",
 CellChangeTimes->{{3.78851992189091*^9, 
  3.788519925263859*^9}},ExpressionUUID->"85a30b0e-ba19-4b9f-9068-\
ab2a861a5075"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Wigner", "-", 
    RowBox[{"d", " ", "Matrices"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"d", "[", 
     RowBox[{"l_", ",", "m_", ",", "mp_"}], "]"}], ":=", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       FractionBox[
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"-", "1"}], ")"}], "k"], 
        RowBox[{"k", "!"}]], "  ", 
       FractionBox[
        RowBox[{
         RowBox[{"Sqrt", "[", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"l", "+", "m"}], ")"}], "!"}], " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"l", "-", "m"}], ")"}], "!"}], " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"l", "+", "mp"}], ")"}], "!"}], " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"l", "-", "mp"}], ")"}], "!"}]}], "]"}], " "}], 
        RowBox[{
         RowBox[{"(", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"l", " ", "+", " ", "m", " ", "-", " ", "k"}], ")"}], 
            "!"}], " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"l", " ", "-", " ", "mp", " ", "-", " ", "k"}], ")"}], 
            "!"}], " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"k", " ", "-", " ", "m", " ", "+", " ", "mp"}], ")"}], 
            "!"}]}], ")"}], " "}]], " ", 
       SuperscriptBox[
        RowBox[{"Cos", "[", 
         FractionBox["\[Beta]", "2"], "]"}], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", "l"}], " ", "+", " ", "m", " ", "-", " ", "mp", " ", 
          "-", " ", 
          RowBox[{"2", "k"}]}], ")"}]], " ", 
       SuperscriptBox[
        RowBox[{"Sin", "[", 
         FractionBox["\[Beta]", "2"], "]"}], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", "k"}], " ", "-", " ", "m", " ", "+", " ", "mp"}], 
         ")"}]]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"k", ",", 
        RowBox[{"Max", "[", 
         RowBox[{"0", ",", 
          RowBox[{"m", "-", "mp"}]}], "]"}], ",", 
        RowBox[{"Min", "[", 
         RowBox[{
          RowBox[{"l", "+", "m"}], ",", 
          RowBox[{"l", "-", "mp"}]}], "]"}]}], "}"}]}], "\[IndentingNewLine]",
      "]"}]}], ";"}]}]], "Code",
 InitializationCell->True,
 CellChangeTimes->{{3.415883824249234*^9, 3.415883841486141*^9}, 
   3.415884336159877*^9, {3.415884591088328*^9, 3.415884597000312*^9}, {
