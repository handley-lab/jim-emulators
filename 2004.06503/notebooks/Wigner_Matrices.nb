 RowBox[{
  RowBox[{"Conjugated", "[", 
   RowBox[{"l_", ",", "m_", ",", "mp_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"d", "[", 
    RowBox[{"l", ",", "m", ",", "mp"}], "]"}], " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}], "^", 
    RowBox[{"{", "}"}]}]}]}]], "Code",
