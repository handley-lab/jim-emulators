              RowBox[{"1.2001101665670462`", " ", 
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{"1", "-", 
                  RowBox[{"4", " ", "\[Eta]\[Eta]"}]}], ")"}], "0.5`"], " ", 
               SuperscriptBox["\[Eta]\[Eta]", "2"], " ", 
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{"\[Chi]\[Chi]1", "-", "\[Chi]\[Chi]2"}], ")"}], 
                "2"]}]}]}]}]}], "\n", "]"}], ";"}]}], "]"}], ";", "\n", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"mode", "\[Equal]", 
          RowBox[{"{", 
           RowBox[{"3", ",", "3"}], "}"}]}], "||", 
