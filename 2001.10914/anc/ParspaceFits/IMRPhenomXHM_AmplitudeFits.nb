\\ndouble noSpin = -1.796444922382065 + 111.51170611049032*eta - \
1728.7493675776548*eta2;\\\\ndouble eqSpin = S*(-1.842119860613924 + \
eta2*(-11235.484645624338 - 2927.019210835522*S) - 0.36655273031432567*S + \
eta*(312.34531117524097 + 128.64488103364167*S));\\\\ndouble uneqSpin = 0.;\\\
\\ntotal = noSpin + eqSpin + uneqSpin;\\\\nbreak;\\\\n}  \
\\\\ndefault:{XLAL_ERROR_REAL8(XLAL_EINVAL,\\\"Error in \
IMRPhenomXHM_Inter_Amp_44_dint0: version is not valid.\\\");}\\\\n}\\\\n \
return total;\\\\n}\\\\n\"\>"}], "Print",
