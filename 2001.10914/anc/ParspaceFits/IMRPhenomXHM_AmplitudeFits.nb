Cell[BoxData[
 RowBox[{
  RowBox[{"TeXExportTabularTable", "[", 
   RowBox[{
   "datatable_", ",", "filename_", ",", "rowLabels_", ",", "colHeadings_", 
    ",", "padZeroes_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "nRows", ",", "tableFormatted", ",", "texTable", ",", "tableAtoms", ",", 
      "maxDecDigits"}], "}"}], ",", "\n", 
    RowBox[{
     RowBox[{"nRows", " ", "=", " ", 
      RowBox[{"Length", "@", "datatable"}]}], ";", "\n", "\n", 
     RowBox[{"tableFormatted", " ", "=", " ", 
      RowBox[{"TableForm", "[", 
       RowBox[{"datatable", ",", " ", 
        RowBox[{"TableHeadings", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"rowLabels", ",", "colHeadings"}], "}"}]}]}], "]"}]}], ";", 
     "\n", 
     RowBox[{"texTable", " ", "=", " ", 
      RowBox[{"ToString", "[", 
       RowBox[{"TeXForm", "[", "tableFormatted", "]"}], "]"}]}], ";", "\n", 
     RowBox[{"texTable", " ", "=", " ", 
      RowBox[{"StringReplace", "[", 
       RowBox[{"texTable", ",", 
        RowBox[{"{", 
         RowBox[{"\"\<array\>\"", "\[Rule]", "\"\<tabular\>\""}], "}"}]}], 
       "]"}]}], ";", "\n", 
     RowBox[{"texTable", " ", "=", " ", 
      RowBox[{"StringReplace", "[", 
       RowBox[{"texTable", ",", 
        RowBox[{"{", 
         RowBox[{"\"\<&\>\"", "\[Rule]", "\"\<$&$\>\""}], "}"}]}], "]"}]}], 
     ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{
      "close", " ", "and", " ", "open", " ", "math", " ", "mode", " ", "at", 
       " ", "each", " ", "field", " ", "separator"}], " ", "*)"}], "\n", 
     RowBox[{"texTable", " ", "=", " ", 
      RowBox[{"StringReplace", "[", 
       RowBox[{"texTable", ",", 
        RowBox[{"{", 
         RowBox[{"\"\<$&$\>\"", "\[Rule]", "\"\<&$\>\""}], "}"}], ",", "1"}], 
       "]"}]}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{
      "remove", " ", "the", " ", "extra", " ", "open$", " ", "at", " ", 
       "first", " ", "separator"}], " ", "*)"}], "\n", 
     RowBox[{"texTable", " ", "=", " ", 
      RowBox[{"StringReplace", "[", 
       RowBox[{"texTable", ",", 
        RowBox[{"{", 
         RowBox[{"\"\<$\\$&$$\>\"", "\[Rule]", "\"\<\\&\>\""}], "}"}], ",", 
        "1"}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "remove", " ", "the", " ", "extra", " ", "elements", " ", "when", " ", 
        "exporting"}], " ", "&"}], " ", "*)"}], "\n", 
     RowBox[{"texTable", " ", "=", " ", 
      RowBox[{"StringReplace", "[", 
       RowBox[{"texTable", ",", 
        RowBox[{"{", 
         RowBox[{"\"\<\\\\\\\\\>\"", "\[Rule]", "\"\<$\\\\\\\\\>\""}], 
         "}"}]}], "]"}]}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{
      "close", " ", "math", " ", "mode", " ", "at", " ", "each", " ", "line", 
       " ", "break"}], " ", "*)"}], "\n", 
     RowBox[{"texTable", " ", "=", " ", 
      RowBox[{"StringReplace", "[", 
       RowBox[{"texTable", ",", 
        RowBox[{"{", 
         RowBox[{"\"\<\\\\\\\\\>\"", "\[Rule]", "\"\<\\\\\\\\$\>\""}], "}"}], 
        ",", "nRows"}], "]"}]}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "reopen", " ", "math", " ", "mode", " ", "after", " ", "each", " ", 
        "line", " ", "break"}], ",", " ", 
       RowBox[{"but", " ", "only", " ", "for", " ", "numrows", " ", 
        RowBox[{"(", 
         RowBox[{"not", " ", "at", " ", "last", " ", "one"}], ")"}]}]}], " ", 
      "*)"}], "\n", 
     RowBox[{"texTable", " ", "=", " ", 
      RowBox[{"StringReplace", "[", 
       RowBox[{"texTable", ",", 
        RowBox[{"{", 
         RowBox[{"\"\<\\\\\\\\\>\"", "\[Rule]", "\"\<\\\\\\\\\\\\hline\>\""}],
          "}"}], ",", "1"}], "]"}]}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{
      "add", " ", "a", " ", "horizontal", " ", "line", " ", "after", " ", 
       "the", " ", "first", " ", 
       RowBox[{"(", "headers", ")"}], " ", "line"}], " ", "*)"}], "\n", 
     RowBox[{"texTable", " ", "=", " ", 
      RowBox[{"StringReplace", "[", 
       RowBox[{"texTable", ",", 
        RowBox[{"{", 
         RowBox[{"\"\<{tabular}{c\>\"", "\[Rule]", "\"\<{tabular}{l\>\""}], 
         "}"}]}], "]"}]}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"make", " ", "row"}], "-", 
       RowBox[{"headers", " ", "column", " ", "left"}], "-", "centered"}], 
      " ", "*)"}], "\n", 
     RowBox[{"texTable", " ", "=", " ", 
      RowBox[{"StringReplace", "[", 
       RowBox[{"texTable", ",", 
        RowBox[{"{", 
         RowBox[{"\"\<cc}\>\"", "\[Rule]", "\"\<cc}\\\\hline\\\\hline\>\""}], 
         "}"}]}], "]"}]}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{"add", " ", "initial", " ", "double", " ", "line"}], " ", 
      "*)"}], "\n", 
     RowBox[{"texTable", " ", "=", " ", 
      RowBox[{"StringReplace", "[", 
       RowBox[{"texTable", ",", 
        RowBox[{"{", 
         RowBox[{
         "\"\<\\\\end{tabular}\>\"", "\[Rule]", 
          "\"\<\\\\hline\\\\hline\\\\end{tabular}\>\""}], "}"}]}], "]"}]}], 
     ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{
      "final", " ", "double", " ", "lines", " ", "at", " ", "end", " ", "of", 
       " ", "table"}], " ", "*)"}], "\n", "\n", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"padZeroes", "\[Equal]", "1"}], ",", " ", 
       RowBox[{"(*", " ", 
        RowBox[{"pad", " ", "trailing", " ", "zeroes"}], " ", "*)"}], "\n", 
       RowBox[{
        RowBox[{"texTable", " ", "=", " ", 
         RowBox[{"StringReplace", "[", 
          RowBox[{"texTable", ",", 
           RowBox[{"{", 
            RowBox[{"\"\<.\\\\times\>\"", "\[Rule]", "\"\<.0\\\\times\>\""}], 
            "}"}]}], "]"}]}], ";"}], "\n", ",", "\n", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"padZeroes", "\[Equal]", "2"}], ",", "\n", 
          RowBox[{
           RowBox[{"texTable", " ", "=", " ", 
            RowBox[{"StringReplace", "[", 
             RowBox[{"texTable", ",", 
              RowBox[{"{", 
               RowBox[{
               "\"\<.\\\\times\>\"", "\[Rule]", "\"\<.00\\\\times\>\""}], 
               "}"}]}], "]"}]}], ";", "\n", 
           RowBox[{"texTable", " ", "=", " ", 
            RowBox[{"StringReplace", "[", 
             RowBox[{"texTable", ",", 
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"\"\<.\>\"", "<>", 
                  RowBox[{"ToString", "@", "i"}], "<>", "\"\<\\\\times\>\""}],
                  "\[Rule]", 
                 RowBox[{"\"\<.\>\"", "<>", 
                  RowBox[{"ToString", "@", "i"}], "<>", 
                  "\"\<0\\\\times\>\""}]}], ",", 
                RowBox[{"{", 
                 RowBox[{"i", ",", "0", ",", "9"}], "}"}]}], "]"}]}], "]"}]}],
            ";"}], "\n", ",", "\n", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"padZeroes", "\[Equal]", "3"}], ",", "\n", 
             RowBox[{
              RowBox[{"texTable", " ", "=", " ", 
               RowBox[{"StringReplace", "[", 
                RowBox[{"texTable", ",", 
                 RowBox[{"{", 
                  RowBox[{
                  "\"\<.\\\\times\>\"", "\[Rule]", "\"\<.000\\\\times\>\""}], 
                  "}"}]}], "]"}]}], ";", "\n", 
              RowBox[{"texTable", " ", "=", " ", 
               RowBox[{"StringReplace", "[", 
                RowBox[{"texTable", ",", 
                 RowBox[{"Table", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"\"\<.\>\"", "<>", 
                    RowBox[{"ToString", "@", "i"}], "<>", 
                    "\"\<\\\\times\>\""}], "\[Rule]", 
                    RowBox[{"\"\<.\>\"", "<>", 
                    RowBox[{"ToString", "@", "i"}], "<>", 
                    "\"\<00\\\\times\>\""}]}], ",", 
                   RowBox[{"{", 
                    RowBox[{"i", ",", "0", ",", "9"}], "}"}]}], "]"}]}], 
                "]"}]}], ";", "\n", 
              RowBox[{"texTable", " ", "=", " ", 
               RowBox[{"StringReplace", "[", 
                RowBox[{"texTable", ",", 
                 RowBox[{"Flatten", "[", 
                  RowBox[{"Table", "[", 
                   RowBox[{
                    RowBox[{"Table", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"\"\<.\>\"", "<>", 
                    RowBox[{"ToString", "@", "i"}], "<>", 
                    RowBox[{"ToString", "@", "j"}], "<>", 
                    "\"\<\\\\times\>\""}], "\[Rule]", 
                    RowBox[{"\"\<.\>\"", "<>", 
                    RowBox[{"ToString", "@", "i"}], "<>", 
                    RowBox[{"ToString", "@", "j"}], "<>", 
                    "\"\<0\\\\times\>\""}]}], ",", 
                    RowBox[{"{", 
                    RowBox[{"i", ",", "0", ",", "9"}], "}"}]}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"j", ",", "0", ",", "9"}], "}"}]}], "]"}], 
                  "]"}]}], "]"}]}], ";"}]}], "\n", "]"}], ";"}]}], "\n", 
         "]"}], ";"}]}], "\n", "]"}], ";", "\n", "\n", 
     RowBox[{"Export", "[", 
      RowBox[{"filename", ",", " ", "texTable", ",", " ", "\"\<Text\>\""}], 
      "]"}], ";"}]}], "\n", "]"}]}]], "Code",
