              "\[Eta]\[Eta]", ",", "\[Chi]\[Chi]1", ",", "\[Chi]\[Chi]2"}], 
              "]"}]}], ";", "\n", 
            RowBox[{"out", " ", "=", " ", 
             RowBox[{"1.2922261617161441`", "\[VeryThinSpace]", "+", 
              RowBox[{"0.0019318405961363861`", " ", "\[Eta]\[Eta]"}], "+", 
              RowBox[{"S", " ", 
               RowBox[{"(", 
                RowBox[{"0.0492798255110865`", "\[VeryThinSpace]", "-", 
                 RowBox[{"0.6703778360948939`", " ", "\[Eta]\[Eta]"}], "+", 
                 RowBox[{"2.6625014134659777`", " ", 
                  SuperscriptBox["\[Eta]\[Eta]", "2"]}]}], ")"}]}], "+", 
              RowBox[{"1.2001101665670462`", " ", 
