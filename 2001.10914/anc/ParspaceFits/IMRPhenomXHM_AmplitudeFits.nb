Cell[BoxData[
 RowBox[{
  RowBox[{"TeXTableOneCoefficient", "[", 
   RowBox[{
   "datadirectory_", ",", "savedirectory_", ",", "mode_", ",", "quantity_"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "fits", ",", "nsfit", ",", "spin1Dfit", ",", "bestfit", ",", "best3Dfit",
       ",", "fs", ",", "ds", ",", "estimate", ",", "rows", ",", "columns", 
      ",", "standarerror", ",", "relerror", ",", "table"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"DirectoryQ", "@", "savedirectory"}], "\[Equal]", "False"}], 
       ",", 
       RowBox[{"CreateDirectory", "[", "savedirectory", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fits", "=", 
      RowBox[{"Get", "[", 
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{"datadirectory", ",", "mode", ",", 
          RowBox[{
          "\"\<CoefficientStats\>\"", "<>", "quantity", "<>", 
           "\"\<.m\>\""}]}], "}"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"nsfit", " ", "=", " ", 
      RowBox[{"\"\<NSFit\>\"", "/.", "fits"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"spin1Dfit", "=", 
      RowBox[{"\"\<1DSpinFit\>\"", "/.", "fits"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"bestfit", "=", 
      RowBox[{"\"\<Best3DFit\>\"", "/.", "fits"}]}], ";", " ", 
     "\[IndentingNewLine]", 
     RowBox[{"best3Dfit", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"\"\<3DFits\>\"", "/.", "fits"}], ")"}], "[", 
       RowBox[{"[", 
        RowBox[{"bestfit", "-", "2"}], "]"}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "I", " ", "saved", " ", "the", " ", "indexes", " ", "of", " ", "the", 
        " ", 
        RowBox[{"Fit3Ds", ":", " ", 
         RowBox[{"3", " ", "-", " ", "6"}]}]}], ",", " ", 
       RowBox[{
        RowBox[{
        "but", " ", "to", " ", "read", " ", "the", " ", "list", " ", "you", 
         " ", "need", " ", "1"}], "-", "4"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"fs", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Position", "[", 
          RowBox[{
           RowBox[{"best3Dfit", "[", 
            RowBox[{"[", "2", "]"}], "]"}], ",", "#"}], "]"}], "&"}], "/@", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"best3Dfit", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"StringContainsQ", "[", 
            RowBox[{
             RowBox[{"ToString", "@", 
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], ",", "\"\<f\>\""}], "]"}], 
           "&"}]}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ds", "=", 
      RowBox[{"Complement", "[", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"1", ",", 
          RowBox[{"Length", "@", 
           RowBox[{"best3Dfit", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}]}], "]"}], ",", "fs"}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"estimate", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"nsfit", "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", "All", ",", "2"}], "]"}], "]"}], ",", 
        RowBox[{"spin1Dfit", "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", 
           RowBox[{"2", ";;"}], ",", "2"}], "]"}], "]"}], ",", 
        RowBox[{"best3Dfit", "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", 
           RowBox[{"Join", "[", 
            RowBox[{"fs", ",", "ds"}], "]"}], ",", "2"}], "]"}], "]"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"standarerror", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"nsfit", "[", 
         RowBox[{"[", "9", "]"}], "]"}], ",", 
        RowBox[{"spin1Dfit", "[", 
         RowBox[{"[", 
          RowBox[{"9", ",", 
           RowBox[{"2", ";;"}]}], "]"}], "]"}], ",", 
        RowBox[{"best3Dfit", "[", 
         RowBox[{"[", 
          RowBox[{"9", ",", 
           RowBox[{"Join", "[", 
            RowBox[{"fs", ",", "ds"}], "]"}]}], "]"}], "]"}]}], "]"}]}], ";", 
     "\n", "     ", 
     RowBox[{"relerror", " ", "=", " ", 
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{"standarerror", "/", "estimate"}], "*", "100"}], "]"}]}], ";",
      "\n", "     ", 
     RowBox[{"rows", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"mySubscript", "[", "#", "]"}], "&"}], "/@", 
         RowBox[{"nsfit", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", "All", ",", "1"}], "]"}], "]"}]}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"mySubscript", "[", "#", "]"}], "&"}], "/@", 
