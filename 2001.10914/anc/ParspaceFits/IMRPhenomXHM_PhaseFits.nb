Cell[CellGroupData[{

Cell["QNM\[CloseCurlyQuote]s and mixing coefficients", "Subchapter",
 CellChangeTimes->{{3.785580479424266*^9, 
  3.785580489623125*^9}},ExpressionUUID->"b8697b77-ae79-4c0d-976a-\
faae399324b3"],

Cell[CellGroupData[{

Cell["Fits of QNM", "Section",
 CellChangeTimes->{{3.785565944234045*^9, 
  3.7855659477426434`*^9}},ExpressionUUID->"b83001c4-eef4-47d4-b023-\
027454b07c5f"],

Cell[TextData[{
 "This section contains fits for the real and imaginary parts of of the \
quasi-normal-mode frequencies, as a function of the final dimensionless spin \
\[Chi].  The fits build on data taken from \
https://pages.jh.edu/~eberti2/ringdown/, see also \
https://arxiv.org/abs/gr-qc/0512160\nThese functions are implemented in ",
 StyleBox["LALSimIMRPhenomXHM_qnm.c",
  FontSlant->"Italic"],
 ".  ",
 StyleBox["evaluate_QNMfit_fringlm",
  FontWeight->"Bold"],
 " and ",
 StyleBox["evaluate_QNMfit_fdamplm",
  FontWeight->"Bold"],
 " return re\[Omega] and im\[Omega] respectively, i.e. the real and imaginary \
parts of the complex QNM frequencies."
}], "Text",
 CellChangeTimes->{{3.7855659663669567`*^9, 3.7855659987476*^9}, {
   3.785566030180146*^9, 3.785566108302639*^9}, {3.785566142647788*^9, 
   3.785566147134276*^9}, 3.785566188882779*^9, {3.785568466411503*^9, 
   3.78556846746467*^9}, {3.785569051033465*^9, 3.785569061525909*^9}, {
   3.785572683873302*^9, 3.785572738071705*^9}, {3.7855800412011766`*^9, 
   3.785580153920166*^9}},
 Background->RGBColor[
  0.87, 0.94, 1],ExpressionUUID->"f76991b7-be48-41ca-ac1e-b7e280eddf46"],

