 CellLabel->"In[24]:=",ExpressionUUID->"421c0691-d931-4ba1-8b5c-82158b46e720"],

Cell[BoxData["\<\"double IMRPhenomXHM_Ringdown_Phase_32_alpha2(double eta, \
double S, double chi1, double chi2, int RingdownPhaseFlag) {\\ndouble \
total=0,eta2,eta3,eta4,eta5;\\neta2 = pow(eta,2);\\neta3 = pow(eta,3);\\neta4 \
= pow(eta,4);\\neta5 = pow(eta,5);\\ndouble noSpin = 0.06508727556277369 + \
81.82151902053695*eta - 496.1922346106388*eta2 + 2631.5581174891404*eta3 - \
8864.303027536791*eta4 + 11817.83797276061*eta5;\\ndouble eqSpin = \
((0.977436415054621 - 4.9556042646000975*eta + \
26.352592393899965*eta2)*S)/(1. - 0.7251106626013689*S);\\ndouble uneqSpin = \
-27.778150812657373*(chi1 - 1.*chi2)*sqrt(1. - 4.*eta)*(1.0250442856060735 + \
1.*chi1*eta - 1.*chi2*eta)*eta2;\\ntotal = noSpin + eqSpin + uneqSpin;\\n\\n \
return total;\\n}\"\>"], "Print",
 CellChangeTimes->{3.785588313541284*^9},
