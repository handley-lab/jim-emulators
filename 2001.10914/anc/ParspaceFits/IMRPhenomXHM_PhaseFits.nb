  3.785582898035659*^9}},ExpressionUUID->"9a478fd3-84b9-4ce6-8c28-\
3a82bba44cda"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalDelta]\[Phi]S", "[", 
    RowBox[{"\[Eta]_", ",", "\[Chi]1_", ",", "\[Chi]2_", ",", "S_", ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "2"}], "}"}]}], "]"}], ":=", 
