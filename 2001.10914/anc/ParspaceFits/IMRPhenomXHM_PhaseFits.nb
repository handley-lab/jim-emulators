Cell[CellGroupData[{

Cell["Time shift of 32 relative to 22 mode", "Subsection",
 CellChangeTimes->{{3.785582404634404*^9, 3.785582426189316*^9}, {
  3.785582470056535*^9, 3.7855824740617*^9}, {3.785583018526059*^9, 
  3.785583019276599*^9}},ExpressionUUID->"9d4ad467-ce57-4cdc-94a4-\
807b8058c584"],

Cell[TextData[{
 "This fit returns the relative difference in phase derivative between 32 and \
22 modes, see Eq. (6.9). The reference frequency at which both phases are \
evaluated is fring22+fdamp22. This function is implemented in ",
 StyleBox["IMRPhenomXHM_RD_Phase_32_SpheroidalTimeShift",
  FontWeight->"Bold"],
 "."
}], "Text",
 CellChangeTimes->{{3.785582508258119*^9, 3.78558260267829*^9}, {
  3.785582795112492*^9, 
  3.785582803312166*^9}},ExpressionUUID->"9b2d9815-80fd-4ac6-afaa-\
937990cd3b83"],

