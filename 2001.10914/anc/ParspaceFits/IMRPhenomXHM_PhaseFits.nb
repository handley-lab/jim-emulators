Cell[CellGroupData[{

Cell["Phase Fits", "Subchapter",
 CellChangeTimes->{{3.785580427260385*^9, 
  3.7855804288523006`*^9}},ExpressionUUID->"1fbaa6ef-8a2a-4b39-9afa-\
c338cddd2536"],

Cell[CellGroupData[{

Cell[TextData[{
 "Inspiral fits (",
 StyleBox["LALSimIMRPhenomXHM_inspiral.c",
  FontSlant->"Italic"],
 ")"
}], "Section",
 CellChangeTimes->{{3.7797968476619797`*^9, 3.779796848778479*^9}, {
  3.7826355898822737`*^9, 3.782635594009882*^9}, {3.785582368283875*^9, 
  3.785582369786832*^9}},ExpressionUUID->"ffab1af0-f8aa-436c-a734-\
d53f5eba338f"],

Cell[TextData[{
 "The fits below model the linear-in-f coefficients of the difference  \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Phi]", "lm"], "(", "f", ")"}], "-", 
    RowBox[{
     FractionBox["m", "2"], 
     RowBox[{
      SubscriptBox["\[Phi]", "22"], "(", 
      RowBox[{
       FractionBox["2", "m"], " ", "f"}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"00baab96-ea0e-4323-9dec-882693554740"],
 ". \n\nThey are applied only beyond a given threshold on the mass-ratio, see \
Eq. (4.12). They correspond to the functions ",
 StyleBox["IMRPhenomXHM_Insp_Phase_**_lambda",
  FontWeight->"Bold"],
 " in ",
 StyleBox["LALSimIMRPhenomXHM_inspiral.c",
  FontSlant->"Italic"],
 "\n\nIn what follows, S=sTotR"
}], "Text",
 CellChangeTimes->{{3.779796901569992*^9, 3.7797970403594027`*^9}, {
  3.7797970834872637`*^9, 3.7797971098735228`*^9}, {3.780032104305678*^9, 
