Cell[CellGroupData[{

Cell["Phase derivatives of 32 mode", "Subsection",
 CellChangeTimes->{{3.785581240254262*^9, 3.78558124767869*^9}, {
  3.7855817076939163`*^9, 3.785581709323357*^9}, {3.78558292949463*^9, 
  3.785582934963971*^9}},ExpressionUUID->"0acba544-3661-412e-b06c-\
0a958d397d9f"],

Cell[TextData[{
 "These fits return the value of the phase derivative of the 32 mode in a \
speroidal-harmonic basis at 4 collocation points in the ringdown region. d\
\[Phi]S32[\[Eta]_,\[Chi]1_,\[Chi]2_,S_,{x,y,z}] returns the phase derivative \
at the point x*fring22+y*fring32+z*fdamp32. \n\nThese fits are implemented in \
",
 StyleBox["LALSimIMRPhenomXHM_ringdown.c, ",
  FontSlant->"Italic"],
 "with the following mapping\n",
 StyleBox[" ",
  FontSlant->"Italic"],
 StyleBox["IMRPhenomXHM_Ringdown_Phase_32_p1 ",
  FontWeight->"Bold"],
 "->d\[Phi]S32[\[Eta]_,\[Chi]1_,\[Chi]2_,S_,{1,0,0}]\n ",
 StyleBox["IMRPhenomXHM_Ringdown_Phase_32_p2 ",
  FontWeight->"Bold"],
 "->d\[Phi]S32[\[Eta]_,\[Chi]1_,\[Chi]2_,S_,{0,1,-1.5}]\n ",
 StyleBox["IMRPhenomXHM_Ringdown_Phase_32_p3 ",
  FontWeight->"Bold"],
 "->d\[Phi]S32[\[Eta]_,\[Chi]1_,\[Chi]2_,S_,{0,1,-0.5}]\n ",
 StyleBox["IMRPhenomXHM_Ringdown_Phase_32_p4 ",
  FontWeight->"Bold"],
 "->d\[Phi]S32[\[Eta]_,\[Chi]1_,\[Chi]2_,S_,{0,1,0.5}]\n  \n  In what \
follows, S=sTotR\n"
}], "Text",
 CellChangeTimes->{{3.785582011978853*^9, 3.785582293031172*^9}, {
  3.785582335721036*^9, 3.785582348121378*^9}},
