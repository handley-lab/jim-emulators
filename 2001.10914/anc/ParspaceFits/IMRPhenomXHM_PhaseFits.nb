Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"fit", "=", 
     RowBox[{"\[Alpha]2fit", "[", 
      RowBox[{"eta", ",", "chi1", ",", "chi2", ",", "S"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "@", 
     RowBox[{"GenerateCollocationPtsCFunction", "[", 
      RowBox[{
       RowBox[{"fit", "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "-", 
             RowBox[{"4", "eta"}]}], ")"}], "^", "0.5`"}], "\[Rule]", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"1", "-", 
            RowBox[{"4", "eta"}]}], "]"}]}], "}"}]}], ",", "eta", ",", "S", 
       ",", "chi1", ",", "chi2", ",", 
       RowBox[{"{", 
