Cell[CellGroupData[{

Cell["Mixing coefficients", "Section",
 CellChangeTimes->{{3.763724397868711*^9, 
  3.763724401123674*^9}},ExpressionUUID->"a8ad3ab1-4f8d-4e26-af23-\
e2a8e258e6f0"],

Cell["\<\
This section contains fits for the mixing coefficients between spin-weighted \
(s=-2) spherical and spheroidal harmonics, as a function of the final \
dimensionless spin \[Chi], see Eq. (A2).  The fits build on data taken from \
https://pages.jh.edu/~eberti2/ringdown/, see also \
https://arxiv.org/abs/1408.1860
\
\>", "Text",
 CellChangeTimes->{{3.7855714012974863`*^9, 3.785571428502783*^9}, {
  3.785571579848957*^9, 3.785571641880316*^9}, {3.785572688960238*^9, 
  3.7855726925042477`*^9}, {3.785572762909088*^9, 3.785572790532639*^9}},
 Background->RGBColor[
  0.87, 0.94, 1],ExpressionUUID->"3a1c3093-e1ec-45a4-955f-37dcb20da1aa"],

Cell[CellGroupData[{

Cell["Fits of mixing coefficients for m=2", "Subsubsection",
 CellChangeTimes->{{3.76527455493541*^9, 3.765274559639758*^9}, {
  3.785571773533049*^9, 3.7855717763714848`*^9}, {3.785571843605803*^9, 
  3.785571854197855*^9}},ExpressionUUID->"ae8582a7-0b0d-483f-acd6-\
ca3de71a2fe6"],

Cell[TextData[{
 "In what follows, \[Alpha]xyz denotes the mixing coefficient between a \
spin-weighted spheroidal harmonic with indices (l,m)=(x,2) and a \
spin-weighted spherical harmonic with indices (l\[CloseCurlyQuote],m)=(y,2). \
We fit separately real and imaginary parts of the coefficients. The former \
are implemented in LAL as ",
 StyleBox["evaluate_QNMfit_re_l*m*lp*",
  FontWeight->"Bold"],
 ", while the latter as evaluate_QNMfit_im_l*m*lp*. For instance,  \
evaluate_QNMfit_re_l3m2lp2 returns the real part of the mixing coefficient \
between a spin-weighted spheroidal harmonic with indices (l,m)=(2,3) and a \
spin-weighted spherical harmonic with indices (l\[CloseCurlyQuote],m)=(2,2). \
"
}], "Text",
 CellChangeTimes->{{3.785571871466135*^9, 3.78557205391192*^9}, {
  3.785572792140486*^9, 3.7855728142398767`*^9}, {3.785576578087531*^9, 
  3.785576594536621*^9}, {3.785576632011825*^9, 3.785576815228215*^9}, {
  3.785577125558085*^9, 3.7855771978861303`*^9}},
 Background->RGBColor[
  0.87, 0.94, 1],ExpressionUUID->"2c529afb-16dc-4401-87d6-1b9510ac527c"]
}, Open  ]],

